<Layouts.app flash={@flash}>
  <section class="py-16">
    <.container class="flex flex-col items-center gap-6">
      <.heading class="max-w-5xl text-center">Every word. Every source. One page.</.heading>
      <.text size="lg" class="max-w-xl text-center">
        Dictionaries, encyclopedias and the culture, by who did the defining. The reader-facing
        pages — search, the word page, the hop — are issue #71. What exists today is the backbone
        and the surfaces that let you see it working.
      </.text>
    </.container>
  </section>

  <.section id="home-surfaces" eyebrow="Developer surfaces" headline="What is built">
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
      <.link
        :for={surface <- @surfaces}
        navigate={surface.path}
        class="flex flex-col gap-1 rounded-xl bg-mist-950/2.5 p-6 hover:bg-mist-950/5 dark:bg-white/5 dark:hover:bg-white/10"
      >
        <span class="text-base/8 font-medium text-mist-950 dark:text-white">{surface.title}</span>
        <span class="text-sm/7 text-mist-700 dark:text-mist-400">{surface.body}</span>
        <span class="mt-1 font-mono text-xs/6 text-mist-500">{surface.path}</span>
      </.link>
    </div>
  </.section>
</Layouts.app>
