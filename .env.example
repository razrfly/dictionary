# Development only. Paste the key after the equals sign.
CINEGRAPH_API_KEY=
CINEGRAPH_GRAPHQL_URL=https://cinegraph.org/api/graphql
GIPHY_API_KEY=
DISCOVERY_POSITIVE_REFRESH_SECONDS=2592000
DISCOVERY_EMPTY_REFRESH_SECONDS=86400
# Optional per-source freshness overrides, for example seven days. The accepted
# names are derived from the provider registry, so every registered provider
# gets <SLUG>_DISCOVERY_POSITIVE_REFRESH_SECONDS and
# <SLUG>_DISCOVERY_EMPTY_REFRESH_SECONDS without another list to edit.
CINEGRAPH_DISCOVERY_EMPTY_REFRESH_SECONDS=
ARTSY_DISCOVERY_EMPTY_REFRESH_SECONDS=
